# Clé API Anthropic (requise pour l'analyse des plans)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé pour l'analyse vision (optionnel, défaut : claude-opus-5)
# ESTIMATEUR_MODEL=claude-opus-5

# Modèle utilisé par le Directeur général IA (optionnel, défaut : claude-opus-5)
# DIRECTEUR_MODEL=claude-opus-5

# Port du serveur (optionnel, défaut : 3000)
# PORT=3000
