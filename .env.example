# === Moteur d'IA des agents ================================================
# Les agents fonctionnent avec DEUX moteurs possibles :
#
#   1. Ollama (GRATUIT, local, sans clé) — recommandé si vous n'avez pas de clé.
#   2. Claude (payant, nécessite ANTHROPIC_API_KEY) — meilleure qualité.
#
# Choix du moteur (optionnel) : "ollama" ou "anthropic".
# Par défaut : "anthropic" si une clé est présente, sinon "ollama".
# AGENTS_PROVIDER=ollama

# --- Option 1 : Ollama (gratuit, local) ------------------------------------
# Installez Ollama depuis https://ollama.com, puis :
#   ollama pull llama3.1        (modèle qui gère les outils du Directeur général)
#   ollama serve                (démarre le serveur local)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT_MS=120000

# --- Option 2 : Claude (payant) --------------------------------------------
# Clé API Anthropic. Requise aussi pour l'estimateur de plans (vision).
# ANTHROPIC_API_KEY=sk-ant-...
# Modèle des agents Claude (optionnel, défaut : claude-opus-5).
# AGENTS_MODEL=claude-opus-5
# Modèle vision de l'estimateur de plans (optionnel, défaut : claude-opus-5).
# ESTIMATEUR_MODEL=claude-opus-5

# Port du serveur (optionnel, défaut : 3000)
# PORT=3000
